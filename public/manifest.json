{
  "manifest_version": 3,
  "name": "Vue Reactivity Tracker",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html"
  },
  "devtools_page": "devtools.html",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

