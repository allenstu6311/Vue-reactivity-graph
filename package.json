{
  "name": "vue-reactivity-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite build --watch --config vite.injected.config.ts\" \"vite build --watch --config vite.extension.config.ts\"",
    "build": "vite build --config vite.injected.config.ts && vite build --config vite.extension.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/dagre": "^0.7.54",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/devtools-api": "^8.1.1",
    "concurrently": "^10.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.13",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@vue-flow/core": "^1.48.2",
    "pinia": "^3.0.4"
  }
}
